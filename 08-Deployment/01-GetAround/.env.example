# Copier vers .env :  cp .env.example .env   (Linux/macOS)
# ou dupliquer le fichier sous le nom .env sous Windows.
# Renseigner les valeurs ; ne jamais committer .env avec de vrais secrets.

# ---------------------------------------------------------------------------
# MLflow — utilisé par l'API (api/app.py) et le notebook d'entraînement
# ---------------------------------------------------------------------------
# Local (notebook) : souvent "mlruns" → dossier notebooks/mlruns
# L'API résout automatiquement "mlruns" vers notebooks/mlruns (même run que le notebook).
# MLFLOW_TRACKING_URI=mlruns
# Production : URL du Space Hugging Face MLflow (ex.)
MLFLOW_TRACKING_URI=https://VOTRE_USERNAME-mlflow.hf.space
# Optionnel local : chemin absolu ex. C:\...\D99-PROJET\notebooks\mlruns

# Option 1 — Model Registry (recommandée en prod) :
# L'API charge le modèle via models:/<nom>@<alias>. Promouvoir une nouvelle version
# = simple changement d'alias côté MLflow UI, sans redéploiement du code API.
MLFLOW_REGISTERED_MODEL=getaround_pricing_model
MLFLOW_MODEL_ALIAS=production
# Nom de l'artefact dans le run (défaut : getaround_pricing_model). Modifier uniquement
# si vous avez changé artifact_path lors du mlflow.sklearn.log_model(...).
MLFLOW_ARTIFACT_PATH=getaround_pricing_model

# Option 2 — Fallback par Run ID (dev / backend file://). Utilisé seulement si
# (MLFLOW_REGISTERED_MODEL + MLFLOW_MODEL_ALIAS) est absent ou si le Registry échoue.
MLFLOW_RUN_ID=

# ---------------------------------------------------------------------------
# AWS — si les artefacts MLflow sont sur S3 (téléchargement par l'API / mlflow)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3

# ---------------------------------------------------------------------------
# Dashboard Streamlit — URL de base de l'API pricing (sans /predict)
# ---------------------------------------------------------------------------
GETAROUND_API_URL=https://VOTRE_USERNAME-getaround-api.hf.space
