# ─── OpenWeatherMap API ───────────────────────────────────
# Inscription gratuite : https://openweathermap.org/api/one-call-3
OPENWEATHERMAP_API_KEY=your_api_key_here

# ─── AWS Credentials ─────────────────────────────────────
# Utilisateur IAM avec accès S3 uniquement (PutObject, GetObject sur le bucket du lab)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-3

# ─── S3 Data Lake ─────────────────────────────────────────
# Bucket du lab cloud ; préfixe imposé pour organiser les livrables Bloc 1
S3_BUCKET_NAME=cloudlab-certification-b6bff020
S3_PREFIX=Bloc-1/Kayak

# ─── Neon PostgreSQL (Data Warehouse) ────────────────────
# Copier la connection string depuis le dashboard Neon (Connection string).
# Doit inclure sslmode=require. Encoder les caractères spéciaux du mot de passe dans l’URL si besoin.
# Exemple : postgresql://user:pass@ep-xxx.eu-west-3.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=
